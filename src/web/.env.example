# URL do projeto Supabase — Project Settings > API > Project URL
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Chave pública anon — Project Settings > API > Project API Keys > anon public
VITE_SUPABASE_ANON_KEY=

# URL da API backend — em dev deixar em branco (proxy do Vite resolve /api → localhost:8000)
# Em produção: https://agroecologia.onrender.com/api
VITE_API_URL=
