# URL do banco de dados
# Desenvolvimento local: deixar em branco (usa ./agroecologia.db)
# Produção (Supabase / Render): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Origens permitidas para CORS (separadas por vírgula)
# Produção: https://seu-projeto.pages.dev,https://dominio-customizado.com.br
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Janela de undo de conclusão em segundos (padrão: 300 = 5 min)
COMPLETION_UNDO_WINDOW_SECONDS=300

# URL do projeto Supabase — Settings > API > Project URL
# Formato: https://xxxx.supabase.co
# Obrigatório em produção; em dev pode deixar em branco para desabilitar auth
SUPABASE_URL=

# URL pública do frontend (usada para montar o redirect_uri do OAuth Google)
# Dev: http://localhost:5173 | Prod: https://agroecologia.g-tazima.workers.dev
FRONTEND_URL=http://localhost:5173

# Google OAuth — criar em console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave de criptografia para tokens OAuth (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
GOOGLE_OAUTH_ENCRYPTION_KEY=

# Worker de sync Google (ativar apenas após credenciais configuradas)
FEATURE_GOOGLE_SYNC_ENABLED=false
GOOGLE_SYNC_POLL_INTERVAL_SECONDS=60
